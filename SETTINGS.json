								"lines": [
									{
										"align": "text-align: left",
										"text": [
											{
												"value": "І, схопивши його, посадив до в'язниці, і передав чотирьом чвіркам вояків, щоб його стерегли, бажаючи вивести людям його по Пасці.",
												"style": " text-align: left;font-size:100px;font-weight:bold;",
												"sourceDynamicKey": "scripture1_text:0"
											}
										]
									}
								],
								"auto": true,
								"textFit": "growToFit"
							},
							{
								"style": "top:505.41px;left:50.00px;height:398.59px;width:1820.00px;",
								"type": "text",
								"lines": [
									{
										"align": "text-align: left",
										"text": [
											{
												"value": "Fattolo arrestare, lo mise in prigione, affidandolo in custodia a quattro mute di soldati di quattro ciascuna, perché voleva farlo comparire davanti al popolo dopo la Pasqua.",
												"style": "text-decoration:;font-size:100px;font-weight:;font-style:;",
												"sourceDynamicKey": "scripture2_text:0"
											}
										]
									}
								],
								"auto": true,
								"textFit": "growToFit"
							},
							{
								"style": "top:969.78px;left:367.50px;height:96.22px;width:1185.33px;",
								"type": "text",
								"lines": [
									{
										"align": "text-align: center",
										"text": [
											{
												"value": "",
												"style": "text-decoration:;font-size:64px;font-weight:bold;"
											}
										]
									}
								],
								"auto": false,
								"textFit": "shrinkToFit",
								"bindings": []
							}
						],
						[
							{
								"style": "top:44.00px;left:50.00px;height:435.79px;width:1813.00px;",
								"type": "text",
								"lines": [
									{
										"align": "text-align: left",
										"text": [
											{
												"value": "Отож, у в'язниці Петра стерегли, а Церква ревно молилася Богові за нього.",
												"style": " text-align: left;font-size:100px;font-weight:bold;",
												"sourceDynamicKey": "scripture1_text:0"
											}
										]
									}
								],
								"auto": true,
								"textFit": "growToFit"
							},
							{
								"style": "top:505.41px;left:50.00px;height:398.59px;width:1820.00px;",
								"type": "text",
								"lines": [
									{
										"align": "text-align: left",
										"text": [
											{
												"value": "Pietro dunque era custodito nella prigione, ma fervide preghiere erano fatte dalla chiesa a Dio per lui.",
												"style": "text-decoration:;font-size:100px;font-weight:;font-style:;",
												"sourceDynamicKey": "scripture2_text:0"
											}
										]
									}
								],
								"auto": true,
								"textFit": "growToFit"
							},
							{
								"style": "top:969.78px;left:367.50px;height:96.22px;width:1185.33px;",
								"type": "text",
								"lines": [
									{
										"align": "text-align: center",
										"text": [
											{
												"value": "",
												"style": "text-decoration:;font-size:64px;font-weight:bold;"
											}
										]
									}
								],
								"auto": false,
								"textFit": "shrinkToFit",
								"bindings": []
							}
						],
						[
							{
								"style": "top:44.00px;left:50.00px;height:435.79px;width:1813.00px;",
								"type": "text",
								"lines": [
									{
										"align": "text-align: left",
										"text": [
											{
												"value": "А як Ірод хотів його вивести, Петро спав тієї ночі між двома вояками, закутий у два ланцюги, і сторожа пильнувала в'язницю при дверях.",
												"style": " text-align: left;font-size:100px;font-weight:bold;",
												"sourceDynamicKey": "scripture1_text:0"
											}
										]
									}
								],
								"auto": true,
								"textFit": "growToFit"
							},
							{
								"style": "top:505.41px;left:50.00px;height:398.59px;width:1820.00px;",
								"type": "text",
								"lines": [
									{
										"align": "text-align: left",
										"text": [
											{
												"value": "Ora la notte prima di quando Erode voleva farlo comparire, Pietro stava dormendo in mezzo a due soldati, legato con due catene, e le guardie davanti alla porta custodivano la prigione.",
												"style": "text-decoration:;font-size:100px;font-weight:;font-style:;",
												"sourceDynamicKey": "scripture2_text:0"
											}
										]
									}
								],
								"auto": true,
								"textFit": "growToFit"
