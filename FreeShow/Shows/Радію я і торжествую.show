["9958377b031",{"name":"Радію я і торжествую","private":false,"category":"song","settings":{"activeLayout":"a186b34c345","template":"small"},"timestamps":{"created":1725016670482,"modified":1789288470529,"used":1789288470527},"quickAccess":{},"meta":{},"slides":{"25914ea11bc":{"group":"куплет","color":"","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Радію я і торжествую -","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Спасенний я кров'ю Христа.","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Gioisco e trionfo ","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Sono salvato dal sangue di Cristo.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"children":["625914ea11b"]},"625914ea11b":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ісуса нині прославляю,","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Як вірне Його я дитя.","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Lodo ora Gesù,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Come un Suo figlio fedele.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"bc3028ac019":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ісус Христос мене звільнив,","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Він дав мені вічне життя,","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Gesù Cristo mi ha liberato,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Mi ha dato la vita eterna,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"chorus","children":["1bc3028ac01"]},"1bc3028ac01":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Гріхи простив, в крові обмив,","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"І нині Його я дитя.","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Ha perdonato i miei peccati, lavandoli nel Suo sangue,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"E ora sono Suo figlio.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":56.375,"textFit":"growToFit"}]},"c019c2cf411":{"group":"куплет2","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Спасенний я, щасливий в Ісусі -","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Словами не можна сказать.","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Sono salvato e felice in Gesù ","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Con le parole non possono esprimerlo.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"children":["ac019c2cf41"]},"ac019c2cf41":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Він в моїм серці поселився","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"І любить у нім пробувать.","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Si è stabilito nel mio cuore","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"E ama dimorarvi.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"cf411f33666":{"group":"куплет3","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Вінець там мій готовий, я знаю,","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"У вічних оселях Отця.","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"La mia corona è pronta lì, lo so,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Nelle dimore eterne del Padre.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"children":["2cf411f3366"]},"2cf411f3366":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Я з вірою Христа чекаю,","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Щоб з Ним пробувать без кінця.","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Aspetto con fede Cristo,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Per dimorare con Lui per sempre.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"ebd9e792598":{"group":"Кінцівка","color":"","settings":{},"notes":"","items":[]}},"layouts":{"a186b34c345":{"name":"Типовий","notes":"","slides":[{"id":"25914ea11bc","children":{"625914ea11b":{}},"background":null},{"id":"bc3028ac019","children":{"1bc3028ac01":{}}},{"id":"c019c2cf411","children":{"ac019c2cf41":{}}},{"id":"bc3028ac019","children":{"1bc3028ac01":{}}},{"id":"cf411f33666","children":{"2cf411f3366":{}}},{"id":"bc3028ac019","children":{"1bc3028ac01":{}}},{"id":"bc3028ac019","children":{"1bc3028ac01":{}}},{"id":"ebd9e792598"}]}},"media":{"2d1dd570ffb":{"name":"5490419-hd_1920_1080_25fps","path":"C:\\Users\\church\\Documents\\5490419-hd_1920_1080_25fps.mp4","type":"video"},"487db458f94":{"name":"3132090-uhd_3840_2160_24fps","path":"C:\\Users\\church\\Documents\\3132090-uhd_3840_2160_24fps.mp4","type":"video"}}}]