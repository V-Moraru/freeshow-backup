["950e3740061",{"name":"Отпускаю все мечты мои","private":false,"category":"song","settings":{"activeLayout":"8b950e37400","template":"small"},"timestamps":{"created":1726254498968,"modified":1780740117947,"used":1780740117947},"quickAccess":{},"meta":{},"slides":{"edcc311e922":{"group":"Куплет","color":"#3D9970","settings":[{}],"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Отпускаю все мечты мои","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Я полагаю их у ног Твоих","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Lascio andare tutti i miei sogni,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Li depongo ai Tuoi piedi","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"globalGroup":"verse","children":["1e0edcc311e","e0edcc311e9","0edcc311e92"]},"1e0edcc311e":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Если в жизни ошибаюсь я","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Твоя любовь не изменяется.","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Se commetto errori nella vita,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Il Tuo amore non cambia","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}]},"e0edcc311e9":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Хотел сразиться я за жизнь мою –","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Ослабли руки, устал я в бою.","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Volevo combattere per la mia vita...","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Le mie mani si sono indebolite, mi sono stancato in battaglia","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":49.75,"align":"","textFit":"growToFit"}]},"0edcc311e92":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ты – сильный Воин, Ты – Царь всех побед!","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Я побеждаю, когда я в Тебе!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Sei un guerriero forte, Sei il Re di tutte le vittorie!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Vinco quando sono in Te","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":59.6875,"align":"","textFit":"growToFit"}]},"e4c0f799bf2":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И даже если горы, не двигаясь, стоят,","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"И даже воды моря не разделяются.","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"E anche se le montagne non si muovessero","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"E se le acque del mare non si separassero.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"globalGroup":"chorus","children":["fe4c0f799bf"]},"fe4c0f799bf":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И если на молитвы не вижу я ответ –","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Доверять, доверять буду я Тебе!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"E se non vedessi risposta alle mie preghiere","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Confiderò, confiderò in Te!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}]},"bf204c63819":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Что завтра мне принесет опять?","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Ты знаешь, все известно для Тебя!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Cosa mi porterà di nuovo il domani?","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Tu lo sai, tutto ti è noto!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"globalGroup":"verse","children":["9bf204c6381"]},"9bf204c6381":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Живи во мне, будь дыханьем моим,","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Дай каждый день ходить путем Твоим!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Vivi in me, sii il mio respiro","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Fammi camminare ogni giorno sulle tue vie","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}]},"8193d55045e":{"group":"Бридж","color":"#f52598","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ты – мой покой и сила, опора Ты моя!","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Мое Ты основание, Ты – крепкая скала!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Sei la mia pace e la mia forza, sei il mio sostegno!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Sei il mio fondamento, sei una roccia salda!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":61.34375,"align":"","textFit":"growToFit"}],"globalGroup":"bridge","children":["38193d55045"]},"38193d55045":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Твои пути прекрасны, они превыше всех!","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Ты держишь эту землю и всё в Твоей руке!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Le tue vie sono meravigliose, sono al di sopra di tutto!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Tieni questa Terra e tutto nella tua mano!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":53.96875,"align":"","textFit":"growToFit"}]},"e2dd37388c0":{"group":"Кінцівка","color":"","settings":{},"notes":"","items":[]},"1d64bbbeb33":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Доверять, доверять буду я Тебе!","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Доверять, доверять буду я Тебе!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"globalGroup":"chorus"}},"layouts":{"8b950e37400":{"name":"Default","notes":"","slides":[{"id":"edcc311e922","children":{"1e0edcc311e":{}}},{"id":"e4c0f799bf2"},{"id":"bf204c63819","children":{"9bf204c6381":{}}},{"id":"e4c0f799bf2"},{"id":"8193d55045e","children":{"38193d55045":{}}},{"id":"e4c0f799bf2","children":{"fe4c0f799bf":{}}},{"id":"1d64bbbeb33"},{"id":"e2dd37388c0"}]}},"media":{}}]