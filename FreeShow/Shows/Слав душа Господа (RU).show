["71a56055f68",{"name":"Слав душа Господа (RU)","private":false,"category":"song","settings":{"activeLayout":"d9f800dbe19","template":"small"},"timestamps":{"created":1734250540612,"modified":1785057350332,"used":1785057350330},"quickAccess":{},"meta":{},"slides":{"25155b26c1b":{"group":"Приспів","color":"#FF851B","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Славь, душа, Господа, Славь, душа","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Имя Святое Его","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Loda il Signore, anima, Loda il Signore, anima,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Il Suo Santo Nome.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"chorus","children":["925155b26c1"]},"925155b26c1":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Пой Ему, как никогда, пой, душа","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Благослови Господа","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Canta a Lui come mai prima, canta, anima,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Benedici il Signore.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"c1b8cd1a8c1":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Солнце встаёт, новый день приходит","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Время опять хвалу воздать","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Il sole sorge, un nuovo giorno arriva,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"È tempo di lodare di nuovo","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"verse","children":["6c1b8cd1a8c"]},"6c1b8cd1a8c":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"За всё, что Ты мне дал, и за каждый","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Новый вдох мой Я буду петь и на закате дня","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Per tutto ciò che mi hai dato, e per ogni mio nuovo respiro","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Canterò anche al tramonto.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":49.75,"textFit":"growToFit"}]},"8c10ba794a8":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Велик в любви, и даёшь мне милость","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Ты справедлив и так благ ко мне","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Grande nell'amore, e mi dai misericordia,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Sei giusto e così buono con me,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"verse","children":["a8c10ba794a"]},"a8c10ba794a":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"За все Твои дела я хочу прославить","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Чтоб петь Тебе, есть 10 тысяч причин","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Per tutte le Tue azioni voglio glorificarti","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Ci sono 10.000 motivi per cantare a Te.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"4a8d0a325b3":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И когда мои силы иссякнут","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"На закате дней, когда время придёт","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"E quando le mie forze saranno esaurite","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"alla tramonto, quando verrà il tempo,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"verse","children":["94a8d0a325b"]},"94a8d0a325b":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Душа моя Тебя да будет славить","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Больше, чем даже 10 тысяч лет","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"che la mia anima Ti lodi","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Anche più di diecimila anni.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"ee1eae151f5":{"group":"Кінцівка","color":"","settings":{},"notes":"","items":[]}},"layouts":{"d9f800dbe19":{"name":"Типовий","notes":"","slides":[{"id":"25155b26c1b"},{"id":"c1b8cd1a8c1","children":{"6c1b8cd1a8c":{}}},{"id":"25155b26c1b"},{"id":"8c10ba794a8","children":{"a8c10ba794a":{}}},{"id":"25155b26c1b"},{"id":"4a8d0a325b3","children":{"94a8d0a325b":{}}},{"id":"25155b26c1b","children":{"925155b26c1":{}}},{"id":"ee1eae151f5"}]}},"media":{}}]