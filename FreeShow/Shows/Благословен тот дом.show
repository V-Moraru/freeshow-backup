rone.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"c58c4b7f259":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Благословен, благословен","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Благословен, тот дом","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Benedetta, benedetta,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Benedetta è quella casa.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["2c58c4b7f25"]},"2c58c4b7f25":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Благословен, благословен","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Благословен, тот дом","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Benedetta, benedetta,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Benedetta è quella casa.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"2592a65f783":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Благословен тот дом, где в тихий час молитвы","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Духом Святым Господь касается сердец","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Benedetta quella casa dove, nell'ora silenziosa della preghiera,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"il Signore tocca i cuori con lo Spirito Santo.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["f2592a65f78"]},"f2592a65f78":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Где радости счастья ,любви в избытке","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"И благодать излил Небесный наш Отец","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Dove abbondano gioia, felicità e amore,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"e il nostro Padre Celeste ha riversato la grazia.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"78330f150c8":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Благословен тот дом, где старость уважают","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Где веру свято берегут из рода в род","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Benedetta la casa dove l’anziano è rispettato,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"dove la fede è sacralmente preservata di generazione in generazione.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["f78330f150c"]},"f78330f150c":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Славят Творца и Библию читают","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"И возрастают в мудрости из года в год","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Lodano il Creatore e leggono la Bibbia,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"e crescono in saggezza di anno in anno","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]}},"layouts":{"62e8467ae75":{"name":"Типовий","notes":"","slides":[{"id":"0ba2c58c4b7"},{"id":"c58c4b7f