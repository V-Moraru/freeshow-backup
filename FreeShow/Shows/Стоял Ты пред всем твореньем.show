["958377b0310",{"name":"Стоял Ты пред всем твореньем","private":false,"category":"song","settings":{"activeLayout":"26c59901569","template":"small"},"timestamps":{"created":1743924990291,"modified":1777801818908,"used":1777801818906},"quickAccess":{},"meta":{},"slides":{"fa043bf5b43":{"group":"куплет","color":"","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Стоял Ты пред всем твореньем","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Вечность держа в руках","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Stavi davanti a tutta la creazione","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Tenendo l'eternità nelle tue mani","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"children":["efa043bf5b4"]},"efa043bf5b4":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Всю землю привел Ты в движенье","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Стою я, склонясь ","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Hai messo in moto l'intera terra","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Io resto in piedi, inchinandomi","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"5b432b00f5c":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Стою, подняв взгляд и руки к небу","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"К Тому, Кто Один отдал мне все","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Sono qua, alzando gli occhi e le mani al cielo","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"A Colui che solo mi ha dato tutto","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"chorus","children":["f5b432b00f5"]},"f5b432b00f5":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Стою, к Тебе Бог склоняю сердце","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Всё во мне Твоё","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Sono qua, a Te, Dio, inchino il mio cuore","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Tutto in me è Tuo","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"df285a3699b":{"group":"куплет2","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Стоял пред моим паденьем","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"И крест Ты пронес за меня","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Eri presente alla mia caduta","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"E hai portato la croce per me","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"children":["fdf285a3699"]},"fdf285a3699":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"На плечи Свои взял весь грех мой","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Стою я, склонясь ","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Sulle tue spalle hai preso tutto il mio peccato","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Io rimango inchinato","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"f3322c1a27f":{"group":"брідж","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Что сделать мне? Что мне сказать?","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Лишь сердце свое Тебе , Могу я отдать","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Cosa posso fare? Cosa posso dire?","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Solo il mio cuore a Te, posso dare","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"children":["6f3322c1a27"]},"6f3322c1a27":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Что сделать мне? Что мне сказать?","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Лишь сердце свое Тебе , Могу я отдать","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Cosa posso fare? Cosa posso dire?","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Solo il mio cuore a Te, posso dare","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"ae151f5046a":{"group":"Кінцівка","color":"","settings":{},"notes":"","items":[]},"f6629397b29":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Всё во мне Твоё","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Всё во мне Твоё","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[],"style":"top:120px;left:50px;height:840px;width:1820px;"}],"globalGroup":"chorus"}},"layouts":{"26c59901569":{"name":"Типовий","notes":"","slides":[{"id":"fa043bf5b43"},{"id":"fa043bf5b43"},{"id":"f3322c1a27f"},{"id":"df285a3699b"},{"id":"f3322c1a27f"},{"id":"5b432b00f5c"},{"id":"5b432b00f5c"},{"id":"f6629397b29"},{"id":"ae151f5046a"}]}},"media":{}}]