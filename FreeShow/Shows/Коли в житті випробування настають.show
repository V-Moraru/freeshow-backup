["d81ca99af91",{"name":"Коли в житті випробування настають","private":false,"category":"song","settings":{"activeLayout":"37009d982ea","template":"double"},"timestamps":{"created":1777795528515,"modified":1794080587434,"used":1794080587434},"quickAccess":{},"meta":{},"slides":{"7009d982ea1":{"group":"Куплет","color":null,"globalGroup":"Куплет","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Коли в житті випробування настають","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Та страх і біль все більше наступає","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}],"children":["009d982ea19"]},"009d982ea19":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"У цих штормах, до Бога я біжу","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Бо в грозах Він лиш підкріпляє","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}]},"09d982ea19d":{"group":"Приспів","color":"#FF851B","globalGroup":"chorus","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ісус, допоможи штормів не уникати","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"А в них черпати силу у  Тобі","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}],"children":["9d982ea19d8"]},"9d982ea19d8":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Дай сили завжди памʼятати","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Що не буває квітів без дощів","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}]},"d982ea19d81":{"group":"Куплет","color":"#3D9970","globalGroup":"verse","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Закінчаться дощі і пройдуть грози","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Господь поможе все тобі пройти","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}],"children":["982ea19d81c"]},"982ea19d81c":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"І зацвітуть прекрасні квіти","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Це Бог дарує їх тобі","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}]},"ea19d81ca99":{"group":"Бридж","color":"#f52598","globalGroup":"bridge","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Після грози цвітуть сади","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"В долинах квіти розквітають","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}],"children":["a19d81ca99a"]},"a19d81ca99a":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"І час випробувань пройде, повір","style":"font-size: 80px;font-weight:bold;white-space:nowr