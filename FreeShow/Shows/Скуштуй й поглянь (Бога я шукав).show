["81e5c8af1d7",{"name":"Скуштуй й поглянь (Бога я шукав)","private":false,"category":"song","settings":{"activeLayout":"f485baf2858","template":"small"},"timestamps":{"created":1728154547967,"modified":1793964341997,"used":1793964341997},"quickAccess":{},"meta":{},"slides":{"485baf28581":{"group":"Тег","color":"#7525f5","globalGroup":"tag","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;","value":"Assaggia e guarda"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false,"language":"it"},{"type":"text","lines":[{"align":"","text":[{"value":"Скуштуй і поглянь","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","align":"","auto":true,"textFit":"growToFit"}]},"40040f0f5fc":{"group":"Куплет","color":"#3D9970","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Бога я шукав, і відповів мені","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"І зберіг мене від усіх страхів","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Ho cercato Dio e mi ha risposto,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"e mi ha salvato da ogni timore.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"globalGroup":"verse","children":["c40040f0f5f"]},"c40040f0f5f":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Світло Він для тих, В кого взір на Ньому","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Не вкриє сором їх, не вкриє сором їх","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Egli è una luce per coloro che hanno gli occhi fissi su di Lui,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"non saranno coperti di vergogna, non coprirà la loro vergogna.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":45.6875,"align":"","textFit":"growToFit"}]},"5fc204b1473":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Вбогий попрохав, І Господь почув","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"І звільнив Його від ворогів","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Il povero chiese, e il Signore ascoltò,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"e lo liberò dai suoi nemici.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"globalGroup":"verse","children":["f5fc204b147"]},"f5fc204b147":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Він Божий Син, оточує святих","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"І звільняє їх, і звільняє їх","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Lui, il Figlio di Dio, circonda i santi,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"e li libera, e li libera.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}]},"47352f29524":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Величайте Господа","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Ім’я Боже піднесемо","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Glorificate il Signore,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"esaltiamo il nome di Dio!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"globalGroup":"chorus","children":["147352f2952"]},"147352f2952":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Величайте Господа","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Славимо Його навіки","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Glorificate il Signore,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"lodiamolo per sempre.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}]},"524f57e6956":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Скуштуй і поглянь, Що Господь благий","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Блаженний ти в тіні Його крил","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Gustate e vedete quanto è buono il Signore.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Beati voi all'ombra delle sue ali.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"globalGroup":"verse","children":["9524f57e695"]},"9524f57e695":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Бійтесь Господа усі Його святі","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"І Він дасть тобі, достаток дасть тобі","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Temete il Signore, voi tutti suoi santi,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Lui ti darà, abbondanza ti darà!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}]},"54436c02dae":{"group":"Бридж","color":"#f52598","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Прославляй Його Кожен день і ніч","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Хай завжди хвала Лине в небеса","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Lodalo ogni giorno e notte","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Fai alzare la lode continuamente al cielo","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"globalGroup":"bridge"},"95214fe25e1":{"group":"Кінцівка","color":"","settings":{},"notes":"","items":[]}},"layouts":{"f485baf2858":{"name":"Типовий","notes":"","slides":[{"id":"40040f0f5fc","children":{"c40040f0f5f":{}}},{"id":"5fc204b1473","children":{"f5fc204b147":{}}},{"id":"47352f29524","children":{"147352f2952":{}}},{"id":"524f57e6956","children":{"9524f57e695":{}}},{"id":"47352f29524"},{"id":"54436c02dae"},{"id":"54436c02dae"},{"id":"54436c02dae"},{"id":"54436c02dae"},{"id":"47352f29524"},{"id":"95214fe25e1"}]}},"media":{}}]