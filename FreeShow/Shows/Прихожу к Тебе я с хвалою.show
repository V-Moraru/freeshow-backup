":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"ab4fbeb1dbd":{"group":"Припев","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"О! Ты велик, Ты прекрасен и велик","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"И другого нет как Ты, и другого нет как Ты","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Tu Grande sei, Quanti miracoli Tu fai","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Nessun altro è come Te, Nessun altro è come Te","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"children":["0ab4fbeb1db"]},"0ab4fbeb1db":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"О! Ты велик, Ты прекрасен и велик","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"И другого нет как Ты, и другого нет как Ты","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Tu Grande sei, Quanti miracoli Tu fai","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Nessun altro è come Te, Nessun altro è come Te","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"b66b59b8cbb":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;","value":"Буду петь Тебе я вечно."}]},{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;","value":"За Твою любовь и милость, "}]},{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;","value":"что даришь Ты нам с небес "}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Ti canterò per sempre","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"per il Tuo amore e la misericordia che ci dai dal cielo","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["363b66b59b8","63b66b59b8c","3b66b59b8cb"]},"363b66b59b8":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;","value":"Буду петь Тебе я вечно.\nЗа Твою любовь и милость, \nчто даришь Ты нам с небес "}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;","value":"Ti canterò per sempre\nper il Tuo amore e la misericordia che ci dai dal cielo"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"63b66b59b8c":