["029958377b0",{"name":"Ісус, Ти переміг","private":false,"category":"song","settings":{"activeLayout":"d139d501d86","template":"small"},"timestamps":{"created":1725745034433,"modified":1791108628451,"used":1791108628447},"quickAccess":{},"meta":{},"slides":{"139d501d86b":{"group":"Тег","color":"#7525f5","globalGroup":"tag","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;","value":"Gesù, hai vinto"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false,"language":"it"},{"type":"text","lines":[{"align":"","text":[{"value":"Ісус, Ти переміг","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","align":"","auto":true,"textFit":"growToFit"}]},"38408021ee9":{"group":"Тег","color":"#7525f5","settings":{},"notes":"","items":[{"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","lines":[{"align":"","text":[{"style":"font-size: 80px;","value":""}]}],"auto":false}],"globalGroup":"tag"},"df701fcd33f":{"group":"Куплет","color":"#3D9970","settings":{"0":{"template":""},"template":"small"},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Невидиму зброю нам дав","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Щоб ворог схилився і впав Коли славлю Тебе, Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Ci ha dato un'arma invisibile","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Così che il nemico si inchini e cada quando ti lodo, Dio","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":56.375,"textFit":"growToFit"}],"globalGroup":"verse","children":["2df701fcd33"]},"2df701fcd33":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Коли є навколо біда","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Прийде перемога Твоя Коли славлю Тебе, Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Quando ci sono problemi tutt'intorno","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"La tua vittoria arriverà quando ti lodo, Dio","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"f5a3e9b6d52":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ісус, Ти переміг","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Весь світ у Твоїх ніг Ти правиш навіки","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Gesù, Tu hai vinto","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Il mondo intero è ai tuoi piedi regni per sempre","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"chorus","children":["3f5a3e9b6d5"]},"3f5a3e9b6d5":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"І не встоїть ніхто","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Перед Тобою, Бог Твоє Царство навіки","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"E nessuno resisterà","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Davanti a te, Dio Il tuo regno è per sempre","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"52b9d6bce31":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ти наміри пекла розбив","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Ніщо не заглушить хвали Коли славлю Тебе, Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Hai spezzato i piani dell'inferno","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Niente soffocherà la lode quando ti lodo, Dio","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"verse","children":["d52b9d6bce3"]},"d52b9d6bce3":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Зруйнуєш Ти стіни гріха","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"І прийде свобода Твоя Коли славлю Тебе, Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Distruggi i muri del peccato","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"E la tua libertà arriverà quando ti lodo, Dio","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"e3176ad662b":{"group":"Бридж","color":"#f52598","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Звучить Твій голос неначе грім","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"О, Ти сильний Бог, Ти сильний Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Risuona la Tua voce come un tuono","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Oh, Tu sei il Dio potente, Tu sei il Dio potente","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"bridge","children":["ce3176ad662"]},"ce3176ad662":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"І як на Небі лунає спів","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"О, Ти сильний Бог, Ти сильний Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"E come in cielo risuona un canto","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Oh, Tu sei il Dio potente, Tu sei il Dio potente","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]}},"layouts":{"d139d501d86":{"name":"Default","notes":"","slides":[{"id":"df701fcd33f","children":{"2df701fcd33":{}}},{"id":"f5a3e9b6d52"},{"id":"52b9d6bce31","children":{"d52b9d6bce3":{}}},{"id":"f5a3e9b6d52"},{"id":"e3176ad662b"},{"id":"e3176ad662b"},{"id":"f5a3e9b6d52"},{"id":"e3176ad662b","children":{"ce3176ad662":{}}},{"id":"f5a3e9b6d52","children":{"3f5a3e9b6d5":{}}},{"id":"38408021ee9"}]}},"media":{}}]