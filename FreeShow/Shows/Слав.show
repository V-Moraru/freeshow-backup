["3d08cdebc89",{"name":"Слав","private":false,"category":"song","settings":{"activeLayout":"6ec27714875","template":"small"},"timestamps":{"created":1726259287754,"modified":1788087350904,"used":1788087350901},"quickAccess":{},"meta":{},"slides":{"d4672666b21":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;","value":"Lodo nella valle e in cima [ -] quando ho tutto - quando impotente"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false,"language":"it"},{"type":"text","lines":[{"align":"","text":[{"style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;","value":"Прославлю в долині І на вершині"}]},{"align":"","text":[{"style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;","value":"Коли маю все - Коли безсилий"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","align":"","auto":true,"textFit":"growToFit"}],"globalGroup":"verse","children":[]},"44bd141568a":{"group":"Куплет","color":"#3D9970","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Прославлю в долині І на вершині","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Коли маю все - Коли безсилий","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Lodo nella valle e sulla vetta","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Quando ho tutto - quando sono senza forze","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"globalGroup":"verse","children":["c44bd141568"]},"c44bd141568":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Прославлю самотнім І разом з народом,","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"У подвигу Бога - Моя перемога!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Lodo da solo e insieme al popolo,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Nell'impresa di Dio è La mia vittoria!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}]},"cc0a7d01b54":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Я кожної миті Буду хвалити!","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Прослав, душа, Господа!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Loderò in ogni istante!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Glorifica, anima, il Signore!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"globalGroup":"chorus","children":["7cc0a7d01b5"]},"7cc0a7d01b5":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Слав, душа, Господа!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Glorifica, anima, il Signore!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}]},"75ab3a67e48":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Хвалю, коли знаю, Коли сумніваюсь,","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Отцю довіряю І мир в серці маю","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Lodo quando so, e quando dubito,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Confido nel Padre e ho pace nel cuore","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"globalGroup":"verse","children":["a75ab3a67e4"]},"a75ab3a67e4":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Хвала - моя зброя І істини Слово,","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Що знищити зможе Стіни Єрихону.","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"La lode è la mia arma e la Parola di verità,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Che può distruggere le mura di Gerico.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}]},"c2067053551":{"group":"Бридж","color":"#f52598","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Не можна ніяк мовчати, бо так","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Дивна Його благодать!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"È impossibile tacere, perche è così","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"meravigliosa la sua grazia","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"globalGroup":"bridge","children":["bc206705355"]},"bc206705355":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Слав, душа, Господа!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Glorifica, anima, il Signore!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}]},"ea0e639341d":{"group":"Бридж","color":"#f52598","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Хвалю, бо Ти правиш В силі Своїй,","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Смерть подолав і так світ полюбив.","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"alig