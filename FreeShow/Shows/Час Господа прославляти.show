["e97bb18309a",{"name":"Час Господа прославляти","private":false,"category":"song","settings":{"activeLayout":"a31ce0e4ae9","template":"double"},"timestamps":{"created":1758982136111,"modified":1789290933810,"used":1789290933806},"quickAccess":{},"meta":{},"slides":{"460133c1168":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Час Господа прославляти","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Час нам принести хвалу   сердець","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"È tempo di lodare il Signore,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"È tempo per noi di portare la lode dei nostri cuori!","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["6460133c116"]},"6460133c116":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Час славу і честь воздати","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Час стать перед Богом таким як є! Час","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"È tempo di dare gloria e onore,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"È tempo di presentarci davanti a Dio così come siamo! È tempo!","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"1682384cf14":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"День прийде і визнає кожен язик","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"І кожен на коліна впаде","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Verrà il giorno e ogni lingua lo riconoscerà,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"E tutti cadranno in ginocchio!","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["11682384cf1"]},"11682384cf1":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;","value":"Вічна нагорода чекає тих"}]},{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;","value":"хто вибрали Тебе"}]},{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;","value":""}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"La ricompensa eterna attende coloro che ti hanno scelto!","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"È tempo!","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]}},"layouts":{"a31ce0e4ae9":{"name":"Типовий","notes":"","slides":[{"id":"460133c1168","children":{"6460133c116":{}}},{"id":"1682384cf14","children":{"11682384cf1":{}}},{"id":"1682384cf14","children":{"11682384cf1":{}}},{"id":"460133c1168","children":{"6460133c116":{}}},{"id":"1682384cf14","children":{"11682384cf1":{}}},{"id":"1682384cf14","children":{"11682384cf1":{}}}]}},"media":{}}]