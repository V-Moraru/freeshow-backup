["19b76c8bd41",{"name":"Вірші на пасху","private":false,"category":"song","settings":{"activeLayout":"dd9d3219b76","template":"default"},"timestamps":{"created":1775336334160,"modified":1775407324407,"used":1775407324400},"quickAccess":{},"meta":{},"slides":{"d9d3219b76c":{"group":"Куплет","color":"#3D9970","globalGroup":"verse","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Усіх, хто прагне Бога величати","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Хто віддає Ісусу славу, честь","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Вітаєм з християнським святом:","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Христос воскрес! Христос воскрес","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"9d3219b76c8":{"group":"Куплет","color":"#3D9970","globalGroup":"verse","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Христос воскрес і нас цим ощасливив","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Смерть не страшна вже для дітей Його","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Христос воскрес, наповнив душі миром —","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Спасіння дарував нам вічний Бог","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"3219b76c8bd":{"group":"Куплет","color":"#3D9970","globalGroup":"verse","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Христос воскрес, щоб мали всі спасіння","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Щоб з тягарем гріха до Нього йшли","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"В Своєму світлім дивнім воскресінні","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Для нас усе Спаситель наш звершив","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"219b76c8bd4":{"group":"Куплет","color":"#3D9970","globalGroup":"verse","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Христос воскрес, для нас воскрес Син Божий","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Тому такий врочистий нині день","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Нехай радіє, тішиться хай кожен","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Хай наші душі сумнів не тривожить","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Бо наш Христос воскрес! Так, Він воскрес","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]}},"layouts":{"dd9d3219b76":{"name":"Типовий","notes":"","slides":[{"id":"d9d3219b76c"},{"id":"9d3219b76c8"},{"id":"3219b76c8bd"},{"id":"219b76c8bd4"}]}},"media":{}}]