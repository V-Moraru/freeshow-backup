["54c4641558d",{"name":"Моя молитва нехай лине","private":false,"category":"song","settings":{"activeLayout":"340f83dd830","template":"double"},"timestamps":{"created":1762626104754,"modified":1793529684571,"used":1793529684570},"quickAccess":{},"meta":{},"slides":{"2d7308dab0c":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Моя молитва нехай лине","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"До Тебе, наче фіміам","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"La mia preghiera scorra","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"A Te, come incenso","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["c2d7308dab0"]},"c2d7308dab0":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"І серце лине безупинно","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"В чудовий Твій небесний храм","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"E il mio cuore si rivolga incessantemente","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Al Tuo meraviglioso tempio celeste","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"d2a6ea6b676":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Боже, я молюсь за Україну","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Боже, молю Тебе за людей","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Dio, io prego per l'Ucraina","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Dio, ti prego per le persone","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["887d2a6ea6b","87d2a6ea6b6","7d2a6ea6b67"]},"887d2a6ea6b":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ти їх прости, Ти їх спаси","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"І милість Свою нам яви","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Perdonali, salvali","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"E mostraci la Tua misericordia","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"87d2a6ea6b6":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Боже, я знаю, що Ти будеш з нами","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"В храмі Твоєму під небесами","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Dio, so che sarai con noi","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Nel Tuo tempio in terra","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"7d2a6ea6b67":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Радість і мир Ти дарував","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Життя за людей віддав В Книгу життя нас записав","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Hai dato gioia e pace","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Hai dato la tua vita per le persone Ci hai scritto nel Libro della Vita","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"6763957c028":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"В Своєму Слові живому","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Ти для життя ведіння дав","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Nella Tua Parola vivente","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Hai dato una guida per la vita","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["b6763957c02"]},"b6763957c02":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Щоб люди всі молились Тому","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Хто на хресті за них вмирав","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Affinché tutte le persone pregassero Colui","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Che è morto sulla croce per loro","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]}},"layouts":{"340f83dd830":{"name":"Типовий","notes":"","slides":[{"id":"2d7308dab0c","children":{"c2d7308dab0":{}}},{"id":"d2a6ea6b676","children":{"887d2a6ea6b":{},"87d2a6ea6b6":{},"7d2a6ea6b67":{}}},{"id":"6763957c028","children":{"b6763957c02":{}}},{"id":"d2a6ea6b676","children":{"887d2a6ea6b":{},"87d2a6ea6b6":{},"7d2a6ea6b67":{}}}]}},"media":{}}]