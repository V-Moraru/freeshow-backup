["1f94760e0a3",{"name":"Боже, в серцях наших","private":false,"category":"song","settings":{"activeLayout":"0b6ef30ec6d","template":"double"},"timestamps":{"created":1752842540568,"modified":1754823500099,"used":1754823500098},"quickAccess":{},"meta":{},"slides":{"df9f20efc66":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Боже, в серцях наших розпали вогонь","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Хай горить не згасне в нас Твоя любов","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Dio, accendi un fuoco nei nostri cuori,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Fai ardere il Tuo amore e non spegnerlo mai in noi.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["5df9f20efc6"]},"5df9f20efc6":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Все, що тільки маєм - власність то Твоя","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Ти тримай нас міцно у Своїх руках","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Tutto ciò che ho è di Tua proprietà","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Tienici saldamente nelle Tue mani.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"af23e316952":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ти наша радість, наше Ти життя","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"В Тобі єдинім світле майбуття","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Sei la nostra gioia, Sei la nostra vita,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Solo in Te è il futuro luminoso,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["1af23e31695"]},"1af23e31695":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Наші молитви чуєш в час тривог","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Ісус Спаситель, Ти наш Цар і Бог","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Senti le nostre preghiere nei momenti difficili,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Gesù il Salvatore, Tu sei il nostro Re e Dio.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"52b1a347caf":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Бережи нас, Боже, в світі цім від зла","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Миром наповни нам усім серця","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Proteggici, Dio, in questo mondo di male,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Riempi tutti i nostri cuori di pace.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["952b1a347ca"]},"952b1a347ca":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"В темноті щоденній зіркою засяй","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Не залишай же нас, не залишай","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Nell'oscurità, risplendi come una stella ogni giorno,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Non lasciarci, non lasciarci.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"caf05960cd6":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Не втрачай надії, зіркою світи","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Щоб могли в темряві люди шлях знайти","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Non perdere la speranza, brilla come una stella,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"affinché le persone possano trovare la loro strada nell'oscurità.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["7caf05960cd"]},"7caf05960cd":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Через перешкоди з піснею пройди","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Ісус вже близько, зустрічать спіши","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Attraverso gli ostacoli con un canto passare,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Gesù è già vicino, affrettati a incontrarlo.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]}},"layouts":{"0b6ef30ec6d":{"name":"Типовий","notes":"","slides":[{"id":"df9f20efc66","children":{"5df9f20efc6":{}}},{"id":"af23e316952"},{"id":"52b1a347caf","children":{"952b1a347ca":{}}},{"id":"af23e316952"},{"id":"caf05960cd6","children":{"7caf05960cd":{}}},{"id":"af23e316952","children":{"1af23e31695":{}}}]}},"media":{}}]