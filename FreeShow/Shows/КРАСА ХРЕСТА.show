["69e618cd4ac",{"name":"КРАСА ХРЕСТА","private":false,"category":"song","settings":{"activeLayout":"9016ea3316f","template":"small"},"timestamps":{"created":1745242737147,"modified":1775403533762,"used":1775403533759},"quickAccess":{},"meta":{},"slides":{"2f53153a519":{"group":"КУПЛЕТ","color":"","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"О, краса ганебного хреста","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Просочила кров Його сповна","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Oh, c'è bellezza in quella croce di vergogna !","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Perché il suo sangue l'ha completamente ricoperta.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"children":["62f53153a51"]},"62f53153a51":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Там гріхи всі прощені мої","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Цим струмком багряної крові","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Lì tutti i miei peccati sono perdonati,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"grazie a quel scorrere rosso di sangue.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"ee1e8b6542c":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ісус мене покликав на імʼя","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Він кров Свою пролив","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Gesù mi ha chiamato per nome,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"ha versato il suo sangue,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["0bee1e8b654","bee1e8b6542"]},"0bee1e8b654":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"В небо шлях відкрив","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Досягнення земні вважаю за сміття…","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Ha aperto la via per il cielo.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Considero i successi terreni come spazzatura...","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"bee1e8b6542":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Спасенний я","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"В цьому є краса хреста","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Sono salvato!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Questa è la bellezza della croce!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"542cdeb73eb":{"group":"КУПЛЕТ","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"У ганебнім, у страшнім хресті","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Маю прощення моїх гріхів","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Nella croce vergognosa, terribile","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"ho il perdono dei miei peccati.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"children":["6542cdeb73e"]},"6542cdeb73e":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Кожна рана і кривавий шрам","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Зцілить душу від гріховних ран","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Ogni sua ferita e cicatrice sanguinante","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"guarisce l'anima mia dalle ferite provocate dal peccato.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"dfeaf0212e7":{"group":"КУПЛЕТ","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Сила й міць ганебного хреста","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Розтрощила мрії зла й гріха","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Il potere e la potenza della croce vergognosa","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"hanno annientato i piani del male e del peccato.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"children":["8dfeaf0212e"]},"8dfeaf0212e":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Воскресінням пекло Спас здолав","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"І смертельні пута розірвав","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Con la resurrezione, il Salvatore ha vinto l'inferno,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"e ha spezzato i legami della morte!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"9d391eff5d2":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ісус мене покликав на імʼя","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Він кров Свою пролив","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Gesù mi ha chiamato per nome,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"ha versato il suo sangue,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["f69d391eff5","69d391eff5d"]},"f69d391eff5":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"В небо шлях відкрив","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Досягнення земні вважаю за сміття…","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Ha aperto la via al cielo.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Considero le conquiste terrene come spazzatura...","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"69d391eff5d":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Спасенний я","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"В цьому є краса хреста","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Sono salvato!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Questa è la bellezza della croce!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"e4da0