["6a4e78abc55",{"name":"Твоя доброта","private":false,"category":"song","settings":{"activeLayout":"8d58cca8236","template":"default"},"timestamps":{"created":1784366583050,"modified":1784373460880,"used":null},"quickAccess":{},"meta":{},"slides":{"d58cca8236a":{"group":"Куплет","color":null,"globalGroup":"Куплет","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Люблю Тебе! Твоя милість нескінченна","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Всі мої дні, я в Твоїх руках Господь","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["58cca8236a4"]},"58cca8236a4":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"З моменту як прокинусь, і доки не засну","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Співатиму про Твою доброту","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"8cca8236a4e":{"group":"Приспів","color":"#FF851B","globalGroup":"chorus","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Усе життя моє Ти вірний","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"В житті моєму, Ти Господь-Благий","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["cca8236a4e7"]},"cca8236a4e7":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"І кожним подихом новим я","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Співатиму про Твою доброту","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"ca8236a4e78":{"group":"Куплет","color":null,"globalGroup":"Куплет","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Твій голос Бог, скрізь вогонь мене провадить","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"В пітьмі нічній, Ти зі мною, мій Господь","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["a8236a4e78a"]},"a8236a4e78a":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Я знаю, Ти мій Батько! Я знаю, Ти мій Друг","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"В Твоїй любові я кожен день живу","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"36a4e78abc5":{"group":"Кінцівка","color":null,"globalGroup":"Кінцівка","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Співатиму про Твою доброту","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"8e1f4a1b721":{"group":"Брідж","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Твоя доброта веде, завжди веде мене","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Твоя благодать веде, завжди веде мене","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["e8e1f4a1b72"]},"e8e1f4a1b72":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Поклоняюся, підкоряюся , Тобі все віддаю","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Твоя благодать веде, завжди веде мене","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]}},"layouts":{"8d58cca8236":{"name":"Типовий","notes":"","slides":[{"id":"d58cca8236a","children":{"58cca8236a4":{}}},{"id":"8cca8236a4e","children":{"cca8236a4e7":{}}},{