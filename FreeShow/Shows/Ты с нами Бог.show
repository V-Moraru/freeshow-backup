["0519dc310f0",{"name":"Ты с нами Бог","private":false,"category":"song","settings":{"activeLayout":"7e1ac88f94a","template":"double"},"timestamps":{"created":1791705444986,"modified":1791716802542,"used":1791716802542},"quickAccess":{},"meta":{},"slides":{"94ab70519dc":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;","value":"Tu sei Dio con noi, Tu sei Dio con noi"}]},{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;","value":"In un cuore ardente germoglierà come una spighetta la nostra fede Tu sei Dio con noi"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"language":"it","bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Ты с нами Бог, Ты с нами Бог","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"В пылком сердце наша вера прорастет как колосок Ты с нами Бог","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}]},"70519dc310f":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;","value":"Tu sei Dio con noi, Tu sei Dio con noi"}]},{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;","value":"In un cuore ardente germoglierà come una spighetta la nostra fede Tu sei Dio con noi"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"language":"it","bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Ты с нами Бог, Ты с нами Бог","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"В пылком сердце наша вера прорастет как колосок Ты с нами Бог","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}]},"6e0958c1f4a":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Из глубин души моей льётся песня о Тебе","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Ты - Господь, кто всех милей в судьбе моей","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Dal profondo della mia anima sgorga un canto per Te,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Tu Signore, sei il più caro di tutti nel mio destino.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["66e0958c1f4"]},"66e0958c1f4":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Век проходит, время мчится, в сердце Божья благодать","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Ну а песню, словно птицу, невозможно удержать","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Il secolo passa, il tempo vola, la grazia di Dio è nel mio cuore,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Mentre il canto, come un uccello, non può essere trattenuto.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"e819a887bc3":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ты с нами Бог, Ты с нами Бог","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Славим имя Христа - нашей веры исток","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Tu sei con noi, Dio, Tu sei con noi, Dio","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Glorifichiamo il nome di Cristo, fonte della nostra fede.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["de819a887bc"]},"de819a887bc":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ты с нами Бог, Ты с нами Бог","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"В пылком сердце наша вера прорастет как колосок Ты с нами Бог","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Tu sei con noi, Dio, Tu sei con noi, Dio","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"In un cuore fervente, la nostra fede germoglierà ","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"bc3480eae0b":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Воздух песнею наполнен, отовсюду голоса","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Пусть её нам подпоют поля, леса","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"L'aria è piena di canti, voci da ogni dove,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Che i campi e le foreste cantino con noi.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["7bc3480eae0"]},"7bc3480eae0":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Это песня о спасеньи, о любви на всей земле","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"О великом искупленьи, о тебе и обо мне","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Questo è un canto di salvezza, di amore in tutta la terra,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"di grande redenzione, di te e di me.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"606ebb06250":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"В нашем сердце Бог и в песне, и в росинке, и в слезе","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"В счастье, в горе с нами вместе, в солнце и грозе","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Dio è nei nostri cuori, nel canto, nelle gocce di rugiada, nelle lacrime,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"nella gioia, nel dolore, è con noi, nel sole e nella tempesta.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["d606ebb0625"]},"d606ebb0625":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Пойте реки, пойте горы, и равнины, и моря","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Имя Господа и веру снова прославляю я","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Cantate, fiumi, cantate, montagne, pianure e mari.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Glorifichiamo il nome del Signore e la fede ancora una volta.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]}},"layouts":{"7e1ac88f94a":{"name":"Типовий","notes":"","slides":[{"id":"6e0958c1f4a"},{"id":"e819a887bc3"},{"id":"bc3480eae0b"},{"id":"e819a887bc3"},{"id":"606ebb06250"},{"id":"e819a887bc3"}]}},"media":{}}]