["e294abdf7d8",{"name":"Бачу Бога кожен день","private":false,"category":"song","settings":{"activeLayout":"54796bf1110","template":"bigBold"},"timestamps":{"created":1753980349117,"modified":1793973006109,"used":1793972996028},"quickAccess":{},"meta":{},"slides":{"ea2b42686a1":{"group":"Куплет","color":"#3D9970","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Бачу Бога кожен день","style":"font-size: 120px;font-weight: bold;"}]},{"align":"","text":[{"value":"Як відкрию вранці свої очі","style":"font-size: 120px;font-weight: bold;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Vedo Dio ogni giorno,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Quando apro gli occhi al mattino,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["1ea2b42686a"]},"1ea2b42686a":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"В дивнім небі голубім","style":"font-size: 120px;font-weight: bold;"}]},{"align":"","text":[{"value":"В перевеслі золотім, як промінь сонця","style":"font-size: 120px;font-weight: bold;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Nel meraviglioso cielo azzurro,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Nella luce dorata, come un raggio di sole.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"0e93b3ef944":{"group":"pre_chorus","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Всюди Ти, Нескінченний Бог - Творець","style":"font-size: 120px;font-weight: bold;"}]},{"align":"","text":[{"value":"Нескінченний Бог-Отець та незмінний у любові","style":"font-size: 120px;font-weight: bold;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Sei ovunque, Dio Infinito - Creatore,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Dio Infinito - Padre immutabile nell'amore.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"children":["50e93b3ef94"]},"50e93b3ef94":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ти - Милосердний і Святий","style":"font-size: 120px;font-weight: bold;"}]},{"align":"","text":[{"value":"Будь на небі й на землі благословен","style":"font-size: 120px;font-weight: bold;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Sei Misericordioso e Santo","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Sii benedetto in cielo e in terra!","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"7569f42123d":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Всюди Ти, Бог Благий","style":"font-size: 120px;font-weight: bold;"}]},{"align":"","text":[{"value":"Слава Тобі, навіки слава","style":"font-size: 120px;font-weight: bold;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Sei ovunque, Buon Dio!","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Gloria a Te, gloria per sempre!","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["c7569f42123"]},"c7569f42123":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Всюди Ти, Бог Благий","style":"font-size: 120px;font-weight: bold;"}]},{"align":"","text":[{"value":"Слава Тобі, навіки слава","style":"font-size: 120px;font-weight: bold;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Sei ovunque, Buon Dio!","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Gloria a Te, gloria per sempre!","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"afa332763d2":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Бачу Бога кожен день:","style":"font-size: 120px;font-weight: bold;"}]},{"align":"","text":[{"value":"В райдузі у небі, та в дощеві","style":"font-size: 120px;font-weight: bold;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Vedo Dio ogni giorno:","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Nell'arcobaleno nel cielo e nella pioggia,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["8afa332763d"]},"8afa332763d":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"В пелюстках троянди, у росі","style":"font-size: 120px;font-weight: bold;"}]},{"align":"","text":[{"value":"У птахах, що восени летять у вирій","style":"font-size: 120px;font-weight: bold;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Nei petali di rosa, nella rugiada,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Negli uccelli che volano in autunno nello stormo.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"3d233373a2c":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Бачу Бога кожен день","style":"font-size: 120px;font-weight: bold;"}]},{"align":"","text":[{"value":"На шляху моїм, що йде до Неба","style":"font-size: 120px;font-weight: bold;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Vedo Dio ogni giorno","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Sul mio cammino che porta al Paradiso.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["63d233373a2"]},"63d233373a2":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"В серці духом Ти живеш","style":"font-size: 120px;font-weight: bold;"}]},{"align":"","text":[{"value":"Ті пісні, що Ти даєш, співа для Тебе","style":"font-size: 120px;font-weight: bold;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Nel mio cuore e nel mio spirito Tu vivi","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Quelle canzoni che Tu doni, io le canto a Te.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]}},"layouts":{"54796bf1110":{"name":"Типовий","notes":"","slides":[{"id":"ea2b42686a1"},{"id":"0e93b3ef944"},{"id":"7569f42123d"},{"id":"afa332763d2"},{"id":"0e93b3ef944"},{"id":"7569f42123d"},{"id":"3d233373a2c"},{"id":"0e93b3ef944"},{"id":"7569f42123d"}]}},"media":{}}]