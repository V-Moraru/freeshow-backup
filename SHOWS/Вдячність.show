["3f1fd585075",{"name":"Вдячність","private":false,"category":"song","settings":{"activeLayout":"2431531aeb1","template":"default"},"timestamps":{"created":1784367207771,"modified":1784455594140,"used":1784455594140},"quickAccess":{},"meta":{},"slides":{"31aeb1a6754":{"group":"Приспів","color":"#FF851B","globalGroup":"chorus","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Тож я руки здійму, Я славлю Тебе знов і знов","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Все, що я маю - це «Алілуя! Алілуя!»","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["1aeb1a67543"]},"1aeb1a67543":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Так мало цього, Та що можу дати Царю?","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Лиш серце, співаюче «Алілуя! Алілуя!»","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"02136229b77":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Всі мої слова зовсім не нові","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Тож про вдячність як я скажу Тобі?","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"globalGroup":"verse","children":["402136229b7"]},"402136229b7":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Всі мої пісні мають свій кінець","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Нескінченний Ти Вічний Бог-Творець","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"2136229b77f":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Все, що можу я і що я зроблю -","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Руки піднесу – і Тобі вклонюсь","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"globalGroup":"verse"},"36229b77f06":{"group":"Брідж","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Слав же, душе чи в радості, чи в журбі","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Пісню співай бо Цар-Лев живе в тобі","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["136229b77f0"]},"136229b77f0":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Тож підведись","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"І слав, душе, Господа","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]}},"layouts":{"2431531aeb1":{"name":"Типовий","notes":"","slides":[{"id":"02136229b77","children":{"402136229b7":{}}},{"id":"31aeb1a6754","children":{"1aeb1a67543":{}}},{"id":"2136229b77f","children":{}},{"id":"31aeb1a6754","children":{"1aeb1a67543":{}}},{"id":"36229b77f06"},{"id":"36229b77f06"},{"id":"36229b77f06"},{"id":"31aeb1a6754","children":{"1aeb1a67543":{}}}]}},"media":{}}]