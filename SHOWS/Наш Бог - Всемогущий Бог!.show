["df91d468310",{"name":"Наш Бог - Всемогущий Бог!","private":false,"category":"song","settings":{"activeLayout":"a091bc2a9c4","template":"small"},"timestamps":{"created":1728803901328,"modified":1792923637939,"used":1792923637937},"quickAccess":{},"meta":{},"slides":{"95721a08631":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Возвысьте голос в песне и слейтесь все в хвале","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Наш Бог - Всемогущий Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Alzate le vostre voci in canto e unitevi nella lode;","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Il nostro Dio è il Dio Onnipotente!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","autoFontSize":95.734375,"align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["2fa95721a08","fa95721a086","a95721a0863"]},"2fa95721a08":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Чтоб вторил хор небесный, восторг был на земле","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Наш Бог - Всемогущий Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Canti così il coro celeste e ci sia gioia sulla terra;","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Il nostro Dio è il Dio Onnipotente!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"fa95721a086":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Хвалите, пламенея, Того, Кто жизнь дарит","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Пусть песнею смелее Благая весть звучит","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Lodate, infiammati, A Colui che dà la vita,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"fate risuonare la buona novella con audacia nel canto.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"a95721a0863":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И расскажите миру о том, каков наш Бог:","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Наш Бог - Всемогущий Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"E dite al mondo com'è il nostro Dio:","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Il nostro Dio è il Dio Onnipotente","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"863142fc026":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Наш Бог – Всемогущий, Царствует во Славе Своей","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Наш Бог – Чудный, Сильный, Любящий, Всемогущий Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Il nostro Dio è Onnipotente, regna nella sua gloria.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Il nostro Dio è Meraviglioso, Forte, Amorevole, Onnipotente Dio.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","autoFontSize":71.578125,"align":"","auto":false,"bindings":[]}],"globalGroup":"chorus"},"c0f7d735a10":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Настанет, братья, славный финал в борьбе земной;","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Наш Бог - Всемогущий Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Fratelli, il glorioso finale giungerà nella lotta terrena;","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Il nostro Dio è il Dio Onnipotente!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","autoFontSize":95.734375,"align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["6a9c0f7d735","a9c0f7d735a","9c0f7d735a1"]},"6a9c0f7d735":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Победу Вождь Державный свершил над силой злой","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Наш Бог - Всемогущий Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Il Sovrano Condottiero ha riportato la vittoria sulla forza del male;","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Il nostro Dio è il Dio Onnipotente!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"a9c0f7d735a":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Наш дух в надежде силен, мы - дети все Творца","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"И радость наполняет спасенные сердца","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Il nostro spirito è forte nella speranza, siamo tutti figli del Creatore,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"e la gioia riempie i cuori salvati.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"9c0f7d735a1":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Мы возвещаем миру о том, каков наш Бог","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Наш Бог - Всемогущий Бог","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Proclamiamo al mondo com'è il nostro Dio;","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Il nostro Dio è il Dio Onnipotente!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:18