["f796a93c997",{"name":"Мы каждый день","private":false,"category":"song","settings":{"activeLayout":"08d0f7f0acb","template":"small"},"timestamps":{"created":1730017088587,"modified":1793998051693,"used":1793998051693},"quickAccess":{},"meta":{},"slides":{"8d0f7f0acb6":{"group":"Тег","color":"#7525f5","globalGroup":"tag","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;","value":"Siamo tutti i giorni"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false,"language":"it"},{"type":"text","lines":[{"align":"","text":[{"value":"Мы каждый день","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","align":"","auto":true,"textFit":"growToFit"}]},"39c10135580":{"group":"Куплет","color":"#3D9970","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Мы каждый день встречаемся вновь c прекрасным словом - словом Любовь","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Мы каждый день за ней летим в мечтах своих","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Ogni giorno ci imbattiamo in una parola bellissima, la parola \"Amore\"","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"La seguiamo ogni giorno nei nostri sogni.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":43.65625,"align":"","textFit":"growToFit"}],"globalGroup":"verse","children":["839c1013558"]},"839c1013558":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Но настоящей любви,увы мы в этом мире не нашли","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"На наш вопрос один ответ любви без Бога нет","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Ma, ahimè, non abbiamo trovato il vero amore in questo mondo,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"C'è una sola risposta alla tua domanda: non c'è amore senza Dio!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":45.6875,"textFit":"growToFit"}]},"80cd7c3be98":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Любовь Христа верна и  чиста она и ласкова и нежна","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Она объемлет всех людей и покорит силой своей","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"L'amore di Cristo è vero e puro, è allo stesso tempo dolce e tenero.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Abbraccia tutti gli uomini e li conquista con il suo potere.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":43.65625,"align":"","textFit":"growToFit"}],"globalGroup":"chorus","children":["580cd7c3be9"]},"580cd7c3be9":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Держитесь этой вы любви","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Она вас к небу приведёт где Иисус спасенных ждет","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Tieni stretto questo amore, ti condurrà in cielo,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Dove Gesù attende i salvati.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":61.34375,"textFit":"growToFit"}]},"e98a414d717":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Но настоящая любовь приходит с синих облаков","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Её дарует вечный Бог – Творец Миров","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Ma il vero amore viene dal cielo,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Che ce lo dona l'eterno Dio, il Creatore dei mondi.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":59.6875,"align":"","textFit":"growToFit"}],"globalGroup":"verse","children":["be98a414d71"]},"be98a414d71":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Она несётся и парит и каждый может получить","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Без денег, злата серебра Любовь Христа","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"E tutti possono ottenerlo,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Senza denaro, oro, argento, è l'amore di Cristo.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"c38321ecc16":{"group":"Кінцівка","color":"","settings":{},"notes":"","items":[]}},"layouts":{"08d0f7f0acb":{"name":"Типовий","notes":"","slides":[{"id":"39c10135580","background":"cfbe562e48f"},{"id":"80cd7c3be98"},{"id":"e98a414d717"},{"id":"80cd7c3be98"},{"id":"80cd7c3be98"},{"id":"c38321ecc16"}]}},"media":{"cfbe562e48f":{"name":"Misty-colors-11_HD","path":"C:\\Users\\chies\\Videos\\Misty_Colors_motions_HD\\Misty_Colors_motions_HD\\Misty-colors-11_HD.mp4","type":"video"}}}]