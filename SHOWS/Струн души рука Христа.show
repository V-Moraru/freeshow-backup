["159ad01378a",{"name":"Струн души рука Христа","private":false,"category":"song","settings":{"activeLayout":"732c8d75069","template":"double"},"timestamps":{"created":1785655812073,"modified":1786268890271,"used":1786268890268},"quickAccess":{},"meta":{},"slides":{"93b71e7ed96":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Струн души рука Христа касается","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"И она восторженно поёт","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"La mano di Cristo tocca le corde dell'anima.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Ed essa canta entusiasta ","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["8982b300c82","193b71e7ed9"]},"193b71e7ed9":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Песнь ещё одна на свет рождается","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Песнь о Том, Кто счастье нам даёт","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Nasce un altro canto al mondo,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Un canto su Colui che ci dona la felicità.","style":"font-size: 80px;color: #dddddd;font-style