ings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Я любовь великую, безмерную","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Нахожу во всём, что видит взор","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Un amore grande e incommensurabile","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Тrovo in ogni cosa che vedo,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["0a2b847f928","f71bc6da9a4"]},"f71bc6da9a4":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И люблю любовью самой нежною","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Я Того, Кто снял с меня позор","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"e amo con il più tenero amore","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Colui che ha tolto la mia vergogna.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"9a4b280a67c":{"group":"Куплет 5","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Струн души рука Христа касается","style":"font-size: 80px;