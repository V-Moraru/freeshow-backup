["1fc3991eee3",{"name":"Ми пам’ятаєм","private":false,"category":"song","settings":{"activeLayout":"7d214ea45f0","template":"double"},"timestamps":{"created":1789838850268,"modified":1789899631490,"used":1789899631487},"quickAccess":{},"meta":{},"slides":{"b67cbbfa14f":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ми пам’ятаєм, ми пам’ятаєм","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Ми пам’ятаєм все те що Ти дав","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Ricordiamo, ricordiamo,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Ricordiamo tutto ciò che hai donato;","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["7b67cbbfa14"]},"7b67cbbfa14":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Скажем всі: \"Великий Бог наш","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"І Дивний в ділах Своїх\"","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Diciamo tutti: \"Grande è il nostro Dio,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"E meraviglioso nelle Sue opere.\"","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"14fdb335fde":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Творець і Бог наш Ти дав життя нам","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Ти спокій наш і радість Господь","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Creatore e nostro Dio, Ci hai dato la vita;","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Sei la nostra pace e gioia, o Signore;","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["a14fdb335fd"]},"a14fdb335fd":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"З року в рік нас провадиш","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Ти мир наш серед штормів","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Anno dopo anno ci guidi,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Sei la nostra pace in mezzo alle tempeste.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"fde1fd3709a":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ти Чудотворний , даєш нам силу","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Через Сина явив благодать","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Tu compi miracoli, ci dai forza;","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Per mezzo di Tuo Figlio, hai rivelato la grazia","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["5fde1fd3709"]},"5fde1fd3709":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ти Відкупитель, ти Утішитель","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Даєш нам вічне життя","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Sei il Redentore, sei il Consolatore,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Ci doni la vita eterna.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"09a560e929a":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Коли проходим земні долини","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Допомагаєш пройти нам цей шлях","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Quando camminiamo nelle valli terrene,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Ci aiuti a percorrere questo cammino;","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["709a560e929"]},"709a560e929":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Скажем всі: \"Великий Бог наш","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"І Дивний в ділах Своїх\"","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Diciamo tutti: Grande è il nostro Dio,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"E meraviglioso nelle Sue opere.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"29a924bcb66":{"group":"Бридж","color":"#f52598","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Алелуя! Алелуя","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Хай лунає слава і хвала","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Alleluia! Alleluia!","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Che risuonino gloria e lode;","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"bridge","children":["929a924bcb6"]},"929a924bcb6":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Алелуя! Алелуя","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Слав земля і небеса","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Alleluia! Alleluia!","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Lodate, o terra e cieli.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"b663c0af531":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ми памʼятаєм коли покликав","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Коли Ти спас нас від гріха","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Ricordiamo quando ci hai chiamati,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Quando ci hai salvati dal peccato,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["cb663c0af53"]},"cb663c0af53":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"І сказав нам що Ти нас любиш","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"І не залишиш повік","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"E ci hai detto che ci ami","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"E che non ci abbandonerai mai.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]}},"layouts":{"7d214ea45f0":{"name":"Типовий","notes":"","slides":[{"id":"b67cbbfa14f"},{"id":"b67cbbfa14f"},{"id":"14fdb335fde"},{"id":"fde1fd3709a"},{"id":"b67cbbfa14f"},{"id":"09a560e929a"},{"id":"29a924bcb66"},{"id":"b67cbbfa14f"},{"id":"b663c0af531"},{"id":"b67cbbfa14f"},{"id":"b67cbbfa14f"}]}},"media":{}}]