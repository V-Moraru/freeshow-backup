["3d91e588b61",{"name":"Будь Прославлений","private":false,"category":"song","settings":{"activeLayout":"56828d36fc6","template":"small"},"timestamps":{"created":1728804785963,"modified":1793530210703,"used":1793530210701},"quickAccess":{},"meta":{},"slides":{"34a4323638a":{"group":"Тег","color":"#7525f5","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;","value":"Sii famoso"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false,"language":"it"},{"type":"text","lines":[{"align":"","text":[{"value":"Будь Прославлений","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","align":"","auto":true,"textFit":"growToFit"}],"globalGroup":"tag"},"c236fed0afe":{"group":"Куплет","color":"#3D9970","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Будь Прославлений, Як рясний плід дає земля","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Як в достатку тече ріка Будь Прославлений","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Sii glorificato, quando la terra produce frutti abbondanti,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Quando il fiume scorre in abbondanza. Sii glorificato!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":49.75,"align":"","textFit":"growToFit"}],"globalGroup":"verse","children":["3c236fed0af"]},"3c236fed0af":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Будь Прославлений Як пустеля самотня скрізь","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Як іду по долинах сліз Будь прославлений","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Sii glorificato quando il deserto è solitario!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Mentre cammino attraverso le valli di lacrime, Sii glorificato!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":47.21875,"textFit":"growToFit"}]},"6fed0afe288":{"group":"Брідж","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Кожен дар Твій повертаю Тобі в хвалі","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Коли темінь наступає, кажу Тобі:","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Per ogni Tuo dono Ti rendo la lode","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Quando cala l'oscurità, Ti dico:","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}]},"ed0afe288a9":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Будь благословен навіки, Будь благословен","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Будь благословен навіки, Господи мій, будь благословен","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Sii benedetto per sempre, Sii benedetto!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Sii benedetto per sempre, mio Signore, sii benedetto!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":57.53125,"align":"","textFit":"growToFit"}],"globalGroup":"chorus"},"88a9917b3f3":{"group":"Куплет 2","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Будь Прославлений, Коли радість цвіте в мені","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Коли світлі приємні дні Будь Прославлений","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Sii glorificato, quando la gioia fiorisce in me","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Nei giorni luminosi e piacevoli, Sii glorificato!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":64,"align":"","textFit":"growToFit"}],"children":["288a9917b3f"]},"288a9917b3f":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Будь Прославлений, Коли в серці страждання й сум","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Коли тяжко свій хрест несу Будь Прославлений","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Sii glorificato, quando nel mio cuore c'è sofferenza e dolore,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"quando porto pesantemente la mia croce, Sii glorificato!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":47.21875,"textFit":"growToFit"}]},"917b3f377e7":{"group":"Бридж","color":"#f52598","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ти дав і Ти забрав, Ти дав і Ти забрав","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Слова ж мої без змін, О, Будь Благословен","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","auto":false,"align":""},{"type":"text","lines":[{"align":"","text":[{"value":"Tu hai dato e tu hai tolto, tu hai dato e tu hai tolto,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Le mie parole rimangono immutate, Oh, Benedetto sii!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","auto":true,"autoFontSize":57.53125,"align":"","textFit":"growToFit"}],"globalGroup":"bridge"},"e25e1ec51ea":{"group":"Кінцівка","color":"","settings":{},"notes":"","items":[]}},"layouts":{"56828d36fc6":{"name":"Типовий","notes":"","slides":[{"id":"c236fed0afe"},{"id":"6fed0afe288"},{"id":"ed0afe288a9"},{"id":"88a9917b3f3"},{"id":"6fed0afe288"},{"id":"ed0afe288a9"},{"id":"917b3f377e7"},{"id":"917b3f377e7"},{"id":"ed0afe288a9"},{"id":"ed0afe288a9"},{"id":"e25e1ec51ea"}]}},"media":{}}]