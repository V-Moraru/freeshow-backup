["773f3b45684",{"name":"Снова год пролетел, День Жатвы настал","private":false,"category":"song","settings":{"activeLayout":"f41bfa07c5a","template":"double"},"timestamps":{"created":1791708313394,"modified":1791711398793,"used":1791711398790},"quickAccess":{},"meta":{},"slides":{"41bfa07c5a5":{"group":"Куплет","color":null,"globalGroup":"Куплет","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Снова год пролетел, День Жатвы настал","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Перед Богом Отцом  ты снова предстал","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}],"children":["1bfa07c5a50"]},"1bfa07c5a50":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Что ты скажешь Ему, как хвалу вознесешь?","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"И какие слова в этот день ты найдёшь?","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}]},"bfa07c5a507":{"group":"Приспів","color":"#FF851B","globalGroup":"chorus","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И в праздник жатвы славу Богу воздай","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Благодарением жизнь свою наполняй","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}],"children":["fa07c5a5077"]},"fa07c5a5077":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И в праздник жатвы  взгляни на свои пути","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Господь, помилуй,  помилуй нас грешных прости","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}]},"a07c5a50773":{"group":"Куплет","color":"#3D9970","globalGroup":"verse","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Вспомни милости, что Бог тебе посылал","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"На молитвы когда Он, твои, отвечал","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}],"children":["07c5a50773f"]},"07c5a50773f":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Каждый миг на путях сберегал и хранил","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Не однажды тебя Он от зла защитил","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}]},"c5a50773f3b":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И в праздник жатвы  взгляни на свои пути","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Господь, помилуй,  помилуй нас грешных прости","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1