["1a4d2044cd2",{"name":"Я пойду за Тобой","private":false,"category":"song","settings":{"activeLayout":"33b9eaa1a4d","template":"small"},"timestamps":{"created":1739087362330,"modified":1772967074096,"used":1772967074094},"quickAccess":{},"meta":{},"slides":{"926c0f90feb":{"group":"Куплет","color":"#3D9970","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Я пойду за Тобой куда бы Ты ни повёл меня","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Я исполню всё, для чего Ты меня призвал","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Ti seguirò ovunque mi condurrai","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Farò tutto ciò che mi hai chiamato a fare","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"verse"},"806e927ef1a":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Мой Бог, мой Бог - большая скала ","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Стена из камня, защита моя","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Mio Dio, mio Dio, grande roccia","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Un muro di pietra, la mia difesa","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"chorus","children":["2b6806e927e","b6806e927ef","6806e927ef1"]},"2b6806e927e":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Спасенье моё, крепость жизни моей ","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Кого мне бояться теперь","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"La mia salvezza, la fortezza della mia vita","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Chi temerò ora?","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"b6806e927ef":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Мой Бог, мой Бог - большая скала ","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Стена из камня, защита моя","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Mio Dio, mio Dio, grande roccia","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Un muro di pietra, la mia difesa","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"6806e927ef1":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Спасенье моё, крепость жизни моей ","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Кого мне страшиться теперь","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"La mia salvezza, la fortezza della mia vita","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Chi temerò ora?","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"e927ef1a4c9":{"group":"Куплет2","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Моя радость в Тебе. Всю свою жизнь я Тебе отдал","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Мои слезы и боль поглотила Твоя любовь","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"La mia gioia è in Te. Ti ho dato tutta la mia vita","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Le mie lacrime e il mio dolore sono inghiottiti dal Tuo amore","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":49.75,"textFit":"growToFit"}]},"28cad7341c8":{"group":"Кінцівка","color":"","settings":{},"notes":"","items":[]}},"layouts":{"33b9eaa1a4d":{"name":"Типовий","notes":"","slides":[{"id":"926c0f90feb"},{"id":"806e927ef1a"},{"id":"e927ef1a4c9"},{"id":"806e927ef1a"},{"id":"28cad7341c8"}]}},"media":{}}]