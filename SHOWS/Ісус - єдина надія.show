["6aa01a54f6d",{"name":"Ісус - єдина надія","private":false,"category":"song","settings":{"activeLayout":"2c974cd3514","template":"small"},"timestamps":{"created":1750450892477,"modified":1783844916748,"used":1783844916746},"quickAccess":{},"meta":{},"slides":{"a829bb3ff17":{"group":"Куплет","color":"#3D9970","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Великий Бог - істинний шлях і майбуття","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Хочу прославити я Тебе, Господь","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Grande Dio, vera via e futuro,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Voglio glorificarti, Signore!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["2a829bb3ff1"]},"2a829bb3ff1":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Одна Любов зцілює зранені серця","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Радість дає вона сповна, Господня Любов","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Solo l'Amore guarisce i cuori feriti,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Dà gioia piena, L'Amore del Signore.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"7e03b2e3d85":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Боже, ось я, Світло у світ нести мені допоможи","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"В серці вогонь Свій запали","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Dio, eccomi, Aiutami a portare la luce al mondo,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Accendi il Tuo fuoco nel mio cuore.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus"},"171e8d6dff6":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ісус - єдина надія","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Ти - дорога до життя","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Gesù è l'unica speranza,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Tu sei la via per la vita.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["b171e8d6dff"]},"b171e8d6dff":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"У Твоїй любові спасіння","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Не знає меж вона - Єдина Ти надія","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Nel Tuo amore è la salvezza,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Non conosce limiti - Tu sei l'unica speranza!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"3e7f1034cd9":{"group":"Брідж","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"В Тобі єдині, в Любові ми","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Хай світ пізнає, що ми тут Твої","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"In Te, siamo uno, nell'Amore,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Che il mondo sappia che noi qua siamo Tuoi.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"children":["b3e7f1034cd"]},"b3e7f1034cd":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Хай Твоє світло горить завжди","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"У небеса Своїх дітей веди","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Che arderda sempre la Tua luce,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Guida i Tuoi figli in cielo.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"229ede72fc8":{"group":"Кінцівка","color":"","settings":{},"notes":"","items":[]}},"layouts":{"2c974cd3514":{"name":"Типовий","notes":"","slides":[{"id":"a829bb3ff17"},{"id":"7e03b2e3d85"},{"id":"171e8d6dff6"},{"id":"a829bb3ff17"},{"id":"7e03b2e3d85"},{"id":"171e8d6dff6"},{"id":"3e7f1034cd9"},{"id":"171e8d6dff6"},{"id":"229ede72fc8"}]}},"media":{}}]