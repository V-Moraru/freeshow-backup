["3bb4b207731",{"name":"Коли в житті випробування настають 2","private":false,"category":"song","settings":{"activeLayout":"39a1080ea92","template":"double"},"timestamps":{"created":1780217386440,"modified":1794082578339,"used":1794082578339},"quickAccess":{},"meta":{},"slides":{"9a1080ea920":{"group":"Куплет","color":null,"globalGroup":"Куплет","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Коли в житті випробування настають","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Та страх і біль все більше наступає","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}],"children":["a1080ea9200"]},"a1080ea9200":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"У цих штормах, до Бога я біжу","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Бо в грозах Він лиш підкріпляє","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}]},"1080ea92003":{"group":"Приспів","color":"#FF851B","globalGroup":"chorus","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ісус, допоможи штормів не уникати","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"А в них черпати силу у  Тобі","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}],"children":["080ea92003b"]},"080ea92003b":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Дай сили завжди памʼятати","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Що не буває квітів без дощів","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}]},"80ea92003bb":{"group":"Куплет","color":null,"globalGroup":"Куплет","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Закінчаться дощі і пройдуть грози","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Господь поможе все тобі пройти","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}],"children":["0ea92003bb4"]},"0ea92003bb4":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"І зацвітуть прекрасні квіти","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Це Бог дарує їх тобі","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}]},"92003bb4b20":{"group":"Брідж","color":null,"globalGroup":"Брідж","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Після грози цвітуть сади","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"В долинах квіти розквітають","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]}],"children":["2003bb4b207"]},"2003bb4b207":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"І час випробувань пройде, повір","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},