["aa171290b76",{"name":"Мій Бог Великий","private":false,"category":"song","settings":{"activeLayout":"a7bd5f5825d","template":"double"},"timestamps":{"created":1763888133902,"modified":1788081322629,"used":1788081322626},"quickAccess":{},"meta":{},"slides":{"5f5825d9be1":{"group":"Перехід","color":null,"globalGroup":"Перехід","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Мій Бог - Могутній, рятунок й фортеця моя","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;","value":"Il mio Dio è potente, mia salvezza e fortezza"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"language":"it","bindings":[]}]},"67cbcf26b87":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Мій Бог Великий ,Бог","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Славити хочу Його кожним словом","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Il mio Dio è grande, Dio","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Voglio lodarlo con ogni parola.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["c67cbcf26b8"]},"c67cbcf26b8":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Рівних Йому нема в славі","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"І милість Його не знає кінця","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Non c'è eguale a Lui in gloria","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"E la Sua misericordia non ha fine","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"bcf26b875c6":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;","value":"Земля і небеса возвеличують славу Його"}]},{"align":"","text":[{"style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;","value":"Ангелів ніжні слова промовляють Що Бог є любов"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Terra e cielo magnificano la Sua gloria","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Le dolci parole degli angeli dicono Che Dio è amore","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse"}},"layouts":{"a7bd5f5825d":{"name":"Типовий","notes":"","slides":[{"id":"67cbcf26b87","children":{"c67cbcf26b8":{}}},{"id":"bcf26b875c6"},{"id":"5f5825d9be1"},{"id":"67cbcf26b87","children":{"c67cbcf26b8":{}}},{"id":"bcf26b875c6