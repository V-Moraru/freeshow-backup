["5a5bd1d3d29",{"name":"Любовь Христа безмерно велика","private":false,"category":"song","settings":{"activeLayout":"03f549d5a5b","template":"small"},"timestamps":{"created":1751034773919,"modified":1787482758688,"used":1787482758687},"quickAccess":{},"meta":{},"slides":{"99e8cde8f5a":{"group":"Куплет","color":"#3D9970","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Любовь Христа безмерно велика:","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Начала нет и льется как река","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"L'amore di Cristo è immensamente grande:","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Non ha inizio e scorre come un fiume,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"verse","children":["699e8cde8f5"]},"699e8cde8f5":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И как волна лобзает берега","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"И глубока, светла и широка","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"E come un'onda bacia le rive,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Profondo, luminoso e ampio.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"f5a87da3274":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И если б не было любви","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Любви Христа, мы б не смогли","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"E se non ci fosse stato l'amore,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"L'amore di Cristo, noi non avremmo avuto la","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"chorus","children":["8f5a87da327"]},"8f5a87da327":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Иметь надежду вечно жить","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"И, как Спаситель, всех людей любить","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"speranza di vivere in eterno","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"E, come il Salvatore, di amare tutti gli uomini.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"2743192e839":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Приди скорей, скорей, тебя Он ждет","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Давно стоит у каменных ворот","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Vieni presto, presto, Lui ti sta aspettando","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"È da tanto che sta alle porte di pietra,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"verse","children":["32743192e83"]},"32743192e83":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Стучит к тебе: открой, уже пора","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Прими любовь без злата, серебра","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Bussando a te: apri, è ora,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Accetta l'amore, senza in cambio oro, senza argento.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":57.53125,"textFit":"growToFit"}]},"8393fa965c9":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"О, если б знал живущий на земле","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Любовь Христа! Лишь ею дышат все","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Oh, se solo chi vive sulla terra conoscesse","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"L'amore di Cristo! Solo grazie a lui tutti respirano!","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":59.6875,"textFit":"growToFit"}],"globalGroup":"verse","children":["e8393fa965c"]},"e8393fa965c":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И если б Бог любовь отнял на миг","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"То этот мир давно б уже погиб","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"E se Dio togliesse l'amore per un momento,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"allora questo mondo sarebbe morto già da tempo.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":57.53125,"textFit":"growToFit"}]},"8c3ae64c383":{"group":"Кінцівка","color":"","settings":{},"notes":"","items":[]}},"layouts":{"03f549d5a5b":{"name":"Типовий","notes":"","slides":[{"id":"99e8cde8f5a"},{"id":"f5a87da3274"},{"id":"2743192e839"},{"id":"f5a87da3274"},{"id":"8393fa965c9"},{"id":"f5a87da3274"},{"id":"8c3ae64c383"}]}},"media":{}}]