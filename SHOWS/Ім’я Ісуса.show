["f29fd1e8d58",{"name":"Ім’я Ісуса","private":false,"category":"song","settings":{"activeLayout":"617800143f2","template":"default"},"timestamps":{"created":1784366292723,"modified":1784384134644,"used":1784384134642},"quickAccess":{},"meta":{},"slides":{"17800143f29":{"group":"Куплет","color":null,"globalGroup":"Куплет","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Промовлю я Ісусове Ім'я","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Щоб скорбота і тривога Зникла вся твоя","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["7800143f29f"]},"7800143f29f":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Промовлю, бо немає більше слів","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Та у відчаї прошу я, Щоб тебе Він зцілив","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"800143f29fd":{"group":"Приспів","color":"#FF851B","globalGroup":"chorus","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Прошу, щоб почув Він, Аби врятував","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Прошу, щоби страх, який в тобі, Ти Богу віддав","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["00143f29fd1"]},"00143f29fd1":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Прошу перемоги в Ісуса Ім'я","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"I знаю, побачу чудеса в Ісуса Ім'я В Його Ім'я","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"0143f29fd1e":{"group":"Куплет","color":null,"globalGroup":"Куплет","