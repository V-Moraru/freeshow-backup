["538e1deb12e",{"name":"Мой дом на небе","private":false,"category":"song","settings":{"activeLayout":"4eb7b77ac05","template":"default"},"timestamps":{"created":1756575361787,"modified":1756632138040,"used":1756632138038},"quickAccess":{},"meta":{},"slides":{"eb7b77ac052":{"group":"Куплет","color":null,"globalGroup":"Куплет","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Мой дом на небе, за облаками","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Где жизни новой уж нет конца","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Друзья, родные где будут с нами","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["b7b77ac0525"]},"b7b77ac0525":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Петь песни славы там у Отца","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Друзья, родные где будут с нами","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Петь песни славы там у Отца","style":"font-size: 100px;"}],"chords":[{"id":"7b77a","pos":22,"key":"Куплет"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"b77ac052538":{"group":"Куплет","color":null,"globalGroup":"Куплет","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"О дом небесный, где быть желаю","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Туда стремлюсь я, чтоб вечно жить;","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Там буду Бога я вечно славить","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["77ac052538e"]},"77ac052538e":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И в свете чудном Христу служить","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Там буду Бога я вечно славить","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"И в свете чудном Христу служить","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"7ac052538e1":{"group":"Куплет","color":null,"globalGroup":"Куплет","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Как в бурю с моря моряк стремится","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Причалить в гавань, чтоб отдохнуть","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Так рвусь я сердцем в жилище света","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["ac052538e1d"]},"ac052538e1d":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Где отдых ждет всех свершивших путь","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Так рвусь я сердцем в жилище света","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Где отдых ждет всех свершивших путь","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"c052538e1de":{"group":"Куплет","color":null,"globalGroup":"Куплет","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Отрадно будет в том вечном доме","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Увижу Друга души моей","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Кто на Голгофе за грех наш умер","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["052538e1deb"]},"052538e1deb":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"И примирил нас с Отцом людей","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Кто на Голгофе за грех наш умер","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"И примирил нас с Отцом людей","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]},"52538e1deb1":{"group":"Куплет","color":null,"globalGroup":"Куплет","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"В печалях горьких слез лить не будем","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Навеки славу мы будем петь;","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Разлуки, скорби, болезнь забудем","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}],"children":["2538e1deb12"]},"2538e1deb12":{"group":null,"color":null,"globalGroup":null,"settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Не будем больше нужды терпеть","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Разлуки, скорби, болезнь забудем","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Не будем больше нужды терпеть","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false}]}},"layouts":{"4eb7b77ac05":{"name":"Типовий","notes":"","slides":[{"id":"eb7b77ac052"},{"id":"b77ac052538"},{"id":"7ac052538e1"},{"id":"c052538e1de"},{"id":"52538e1deb1"}]}},"media":{}}]