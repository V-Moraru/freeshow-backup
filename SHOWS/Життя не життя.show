["517f68a90a5",{"name":"Життя не життя","private":false,"category":"song","settings":{"activeLayout":"49c27ee66a5","template":"small"},"timestamps":{"created":1727592068399,"modified":1780739851155,"used":1780739851155},"quickAccess":{},"meta":{},"slides":{"9c27ee66a52":{"group":"Тег","color":"#7525f5","globalGroup":"tag","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"style":"font-size: 80px;","value":"La vita non è la vita"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false,"language":"it"},{"type":"text","lines":[{"align":"","text":[{"value":"Життя не життя","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","align":"","auto":true,"textFit":"growToFit"}]},"34bd918e4ed":{"group":"Куплет","color":"#3D9970","settings":{"template":""},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Твоєю благодаттю наповнена земля","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Веде мене в житті Твоя рука!!!","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"La terra è piena della tua grazia. ","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"La tua mano mi guida attraverso la vita.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"verse","children":["a34bd918e4e"]},"a34bd918e4e":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Понад усе на світі найбільше надбання","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"То право пізнання Христа","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Questo è il bene più grande del mondo: ","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"il diritto di conoscere Cristo","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}]},"d918e4ede41":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Життя - не життя Без Ісуса Христа","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Він вся повнота Алелуя (Алелуя)","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"La vita non è vita senza Gesù Cristo","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Egli è tutta la pienezza Alleluia (alleluia)","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"chorus"},"e417eea234a":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ти моя надія, Ти моє майбуття","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Все, що без Тебе, то марнота","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Tu sei la mia speranza, tu sei il mio futuro.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Tutto senza di Te è vanità.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":64,"textFit":"growToFit"}],"globalGroup":"verse","children":["de417eea234"]},"de417eea234":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Дай сили так прожити, щоб почути","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Ті слова, Прошу тебе заходь, моє дитя","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Dammi la forza di vivere affinché io possa sentire quelle parole. ","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Entra pure, figlio mio.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":45.6875,"textFit":"growToFit"}]},"fc76f75dc80":{"group":"Брідж","color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Куди піду від Тебе Де зможу заховатись я?","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Ти - Бог наш всевидючий В Твоїй долоні вся Земля","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Dove posso andare lontano da Te, dove posso nascondermi?","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Tu sei il nostro Dio onnisciente, l'intera Terra è nel tuo palmo.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":47.21875,"textFit":"growToFit"}],"children":["60fc76f75dc","0fc76f75dc8"]},"60fc76f75dc":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Куди піду від Тебе Де зможу заховатись я?","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Ти - Бог наш всевидючийВ Твоїй долоні вся Земля","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"Dove posso andare lontano da Te, dove posso nascondermi?","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"Tu sei il nostro Dio onnisciente, l'intera Terra è nel tuo palmo.","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;height:330.02px;width:1820px;","language":"it","align":"","auto":true,"autoFontSize":47.21875,"textFit":"growToFit"}]},"0fc76f75dc8":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"В Тобі моя мета покину своє «Я»","style":"font-size: 80px;"}]},{"align":"","text":[{"value":"Господь, вся слава Твоя","style":"font-size: 80px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","align":"","auto":false},{"type":"text","lines":[{"align":"","text":[{"value":"In Te è il mio fine, abbandonerò il mio \"io\" Signore,","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]},{"align":"","text":[{"value":"tutta la gloria è Tua","style":"text-transform:uppercase;white-space:nowrap;font-style:italic;font-size:64px;"}]}],"style":"top:712.98px;left:50.00px;