["cc72a9ea5a7",{"name":"Як олень прагне до потоків","private":false,"category":"song","settings":{"activeLayout":"80fafc1ec49","template":null},"timestamps":{"created":1754508422917,"modified":1761480157701,"used":1761480157699},"quickAccess":{},"meta":{},"slides":{"33afe569d08":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"COME IL CERVO ANELA L'ACQUA","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"L'ALMA MIA BRAMA SOLO TE","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","bindings":[]}],"globalGroup":"verse","children":["933afe569d0"]},"933afe569d0":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"SEI TU SOL CIO'","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"CHE IL CUOR MIO BRAMA","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"E VOGLIO ADORARE TE","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;"}]},"afe569d081e":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"DA TE SOL PRENDO FORZA O, DIO","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"IN TE SOL POSSO RIPOSAR","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","bindings":[]}],"globalGroup":"chorus","children":["3afe569d081"]},"3afe569d081":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"SEI TU SOL CIO' CHE IL CUOR MIO BRAMA","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"E VOGLIO ADORARE TE","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;"}]},"2634c640e90":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Як олень прагне до потоків","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Так душа моя прагне Тебе","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Come il cervo anela ai ruscelli,","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"così la mia anima anela a Te,","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","language":"it","bindings":[]}],"globalGroup":"verse","children":["62634c640e9"]},"62634c640e9":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Я бажаю Тобі сказати","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Що я так люблю Тебе","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;"},{"type":"text","lines":[{"align":"","text":[{"value":"voglio dirti,","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"che ti amo così tanto.","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","language":"it"}]},"e90ae0f81e8":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Ти один моє серце знаєш","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"І в нього Ти любов вливаєш","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Tu solo conosci il mio cuore,","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"e ci versi amore,","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","language":"it","bindings":[]}],"globalGroup":"chorus","children":["0e90ae0f81e"]},"0e90ae0f81e":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Я бажаю Тобі сказати","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Що я так люблю Тебе","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;"},{"type":"text","lines":[{"align":"","text":[{"value":"voglio dirti,","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"che ti amo così tanto.","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","language":"it"}]},"1e8c84d4d1b":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Щирим серцем Тебе кохаю","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Бо життя дарував Ти мені","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Ti amo con tutto il cuore","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"perché mi hai donato la vita.","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","language":"it","bindings":[]}],"globalGroup":"verse","children":["81e8c84d4d1"]},"81e8c84d4d1":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"За Твою доброту та ласку","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"Дуже вдячний я Тобі","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;"},{"type":"text","lines":[{"align":"","text":[{"value":"Per la tua gentilezza e grazia","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"ti sono molto grato.","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","language":"it"}]},"d1b7113a34c":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Простягнув Ти пробиті руки","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"І від смерті мене врятував","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Hai steso le tue mani trafitte","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"e mi hai salvato dalla morte","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","language":"it","bindings":[]}],"globalGroup":"verse","children":["4d1b7113a34"]},"4d1b7113a34":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Щоб мене захистить від муки","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"На хресті Ти кров пролляв","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;"},{"type":"text","lines":[{"align":"","text":[{"value":"per proteggermi dal tormento","style":"font-size: 100px;"}]},{"align":"","text":[{"value":"sulla croce hai versato il tuo sangue.","style":"font-size: 100px;"}]}],"style":"top:120px;left:50px;height:840px;width:1820px;","language":"it"}]}},"layouts":{"80fafc1ec49":{"name":"Типовий","notes":"","slides":[{"id":"2634c640e90"},{"id":"e90ae0f81e8"},{"id":"33afe569d08"},{"id":"afe569d081e"},{"id":"1e8c84d4d1b"},{"id":"e90ae0f81e8"},{"id":"d1b7113a34c"},{"id":"e90ae0f81e8"}]}},"media":{}}]