["a5a425b4fb4",{"name":"Так уж бывает летней порой","private":false,"category":"song","settings":{"activeLayout":"c617670479a","template":"double"},"timestamps":{"created":1760221716742,"modified":1791717591138,"used":1791717591134},"quickAccess":{},"meta":{},"slides":{"f0f12f8a2bb":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Так уж бывает летней порой","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Когда луч солнца радует нас","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Così è d'estate,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"quando il raggio del sole ci delizia,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["5f0f12f8a2b"]},"5f0f12f8a2b":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Час испытанья черной рукой","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Небо закроет от нас","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"l'ora della prova, con la sua mano scura,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"ci nasconde il cielo.","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"2bbbdf08557":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Пусть даже не станет овец в загоне","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"И виноград не даст плода","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Anche se non ci fossero più pecore nell'ovile,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"e la vigna non portasse frutto,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["a2bbbdf0855"]},"a2bbbdf0855":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Все равно я буду славить","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Господа Христа","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"loderò comunque","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"il Signore Cristo!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"557e7191279":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Если закружит меня волною","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"В водовороте суетного дня","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Se l'onda mi travolgesse","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"nel vortice di un giorno vano,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["8557e719127"]},"8557e719127":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Верой поднявшись над суетою","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Вдруг запоет душа моя:","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"con fede elevandomi al di sopra delle circostanze,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"la mia anima inizierà a cantare:","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"279f5474712":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Если бывает теряешь что-то","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]},{"align":"","text":[{"value":"Вспомни слова Иисуса Христа:","style":"font-size: 80px;font-weight:bold;white-space:nowrap;color: #dddddd;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Se mai dovessi perdere qualcosa,","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"ricorda le parole di Gesù Cristo:","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["1279f547471"]},"1279f547471":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"«Где ваша ценность - там сердце будет!»","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Значит, потеря не велика","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"\"Dov'è il vostro tesoro, lì sarà il vostro cuore!\"","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]},{"align":"","text":[{"value":"Significa che la perdita non è grande!","style":"font-size: 80px;color: #dddddd;font-style:italic;color: #dddddd;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]}},"layouts":{"c617670479a":{"name":"Типовий","notes":"","slides":[{"id":"f0f12f8a2bb"},{"id":"2bbbdf08557"},{"id":"2bbbdf08557"},{"id":"557e7191279"},{"id":"2bbbdf08557"},{"id":"2bbbdf08557"},{"id":"279f5474712"},{"id":"2bbbdf08557"},{"id":"2bbbdf08557"}]}},"media":{}}]