["bc40f886983",{"name":"Когда Христос меня простил 2","private":false,"category":"song","settings":{"activeLayout":"5b3cc63c3e9","template":"double"},"timestamps":{"created":1777794231278,"modified":1789293183727,"used":1789293183723},"quickAccess":{},"meta":{},"slides":{"032b8bd6062":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Когда Христос меня простил","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Он землю в небо превратил","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Quando Cristo mi perdonò,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"trasformò la terra in cielo,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["a032b8bd606"]},"a032b8bd606":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Среди скорбей, среди угроз –","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Там небо, где со мной Христос","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Tra dolori, tra minacce","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Il paradiso è dove Cristo è con me.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"062a5ac0d0a":{"group":"Приспів","color":"#FF851B","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Хвала Христу, Он спас меня","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Простил грехи, открыл Себя","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Lode a Cristo, mi ha salvato,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Ha perdonato i miei peccati, si è rivelato,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"chorus","children":["6062a5ac0d0"]},"6062a5ac0d0":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"На суше, в море, над землей –","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Там небо, где Христос со мной","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Sulla terraferma, in mare, sopra la terra ","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Il paradiso è dove Cristo è con me","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"d0a249ad8ee":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Небесный мир мне был далек","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Меня Христос к Себе привлек","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Il mondo celeste era lontano da me,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Cristo mi ha attirato a Sé,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["0d0a249ad8e"]},"0d0a249ad8e":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Когда вошел Он в жизнь мою","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"С тех пор о Нем всегда пою","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Quando è entrato nella mia vita,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"Da allora ho sempre cantato di Lui.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]},"8ee9851d370":{"group":"Куплет","color":"#3D9970","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"Неважно, где теперь живу:","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"На высоте, внизу во рву","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"Non importa dove vivo ora:","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"in alto, giù nel fosso,","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}],"globalGroup":"verse","children":["d8ee9851d37"]},"d8ee9851d37":{"group":null,"color":"","settings":{},"notes":"","items":[{"type":"text","lines":[{"align":"","text":[{"value":"В стране родной, в стране чужой –","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]},{"align":"","text":[{"value":"Там небо, где Христос со мной","style":"font-size: 80px;font-weight:bold;white-space:nowrap;"}]}],"style":"top:40.00px;left:30.00px;width:1860px;height:500px;","align":"","auto":false,"bindings":[]},{"type":"text","lines":[{"align":"","text":[{"value":"nella mia terra natale, in una terra straniera","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]},{"align":"","text":[{"value":"il paradiso è dove Cristo è con me.","style":"font-size: 80px;color: #dddddd;font-style:italic;"}]}],"style":"top:562.43px;left:30.00px;width:1860px;height:500px;","language":"it","align":"","auto":false,"bindings":[]}]}},"layouts":{"5b3cc63c3e9":{"name":"Типовий","notes":"","slides":[{"id":"032b8bd6062","children":{"a032b8bd606":{}}},{"id":"062a5ac0d0a","children":{"6062a5ac0d0":{}}},{"id":"062a5ac0d0a","children":{"6062a5ac0d0":{}}},{"id":"d0a249ad8ee","children":{"0d0a249ad8e":{}}},{"id":"062a5ac0d0a","children":{"6062a5ac0d0":{}}},{"id":"062a5ac0d0a"},{"id":"8ee9851d370","children":{"d8ee9851d37":{}}},{"id":"062a5ac0d0a","children":{"6062a5ac0d0":{}}},{"id":"062a5ac0d0a","children":{"6062a5ac0d0":{}}}]}},"media":{}}]